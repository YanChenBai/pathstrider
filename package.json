{
  "name": "pathstrider",
  "version": "0.0.1",
  "description": "Configurable end-to-end type-safe routing for Nitro, powered by Standard Schema and Ky.",
  "keywords": [
    "end-to-end-types",
    "ky",
    "nitro",
    "nitrojs",
    "standard-schema",
    "type-safe",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/YanChenBai/pathstrider#readme",
  "bugs": {
    "url": "https://github.com/YanChenBai/pathstrider/issues"
  },
  "license": "MIT",
  "author": "byc <bycrxemail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanChenBai/pathstrider.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./error-handler": "./dist/error-handler.mjs",
    "./routes": "./dist/routes.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "release": "vp run check && vp run test && changelogen --release"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ky": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "bumpp": "^11.1.0",
    "changelogen": "^0.6.2",
    "nitro": "3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "nitro": ">=3.0.0-beta",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
